{"shots": [{"badge": "DAY 1 · 07:12", "loc": "The Last Man · episode 1", "scene": "wake", "card": "news", "vo": "You wake up. Every news channel says the same thing: last night every man on Earth vanished. *Except one*."}, {"badge": "07:13", "loc": "Kitchen", "scene": "clock", "vo": "The kitchen clock has stopped at *three thirty-three*."}, {"badge": "07:15", "loc": "Entrance", "scene": "door", "vo": "A knock at the door. On the intercom screen — people *in white suits*."}, {"badge": "07:16", "loc": "Yard", "scene": "jump", "vo": "You jump from the second-floor balcony and *run*."}, {"badge": "07:18", "loc": "Street", "scene": "drone", "vo": "A drone hovers over the street. A red light. *It sees you*."}, {"badge": "07:19", "loc": "Corner", "scene": "car", "vo": "A car brakes at the corner. A woman is driving."}, {"badge": "07:19", "loc": "Corner", "scene": "car2", "who": "g", "vo": "*Get in. Now.*"}, {"badge": "07:19", "loc": "Corner", "scene": "car3", "vo": "Behind you — *sirens*."}, {"badge": "CHOICE", "loc": "You decide", "scene": "choice", "card": "choice", "vo": "What do you do? *One* — get in with the stranger. *Two* — run to the subway, there are no drones there. Tell me in the comments."}], "meta": [{"dur": 7.236791666666667, "phr": [[0, 0.8592708333333333, "You wake up."], [1.3092708333333334, 3.4381041666666663, "Every news channel says the same thing:"], [3.6581041666666665, 5.913208333333333, "last night every man on Earth vanished."], [6.363208333333334, 7.236791666666667, "*Except one*."]]}, {"dur": 2.5925833333333332, "phr": [[0, 2.5925833333333332, "The kitchen clock has stopped at *three thirty-three*."]]}, {"dur": 4.6869375, "phr": [[0, 1.2299583333333333, "A knock at the door."], [1.6799583333333332, 3.0690416666666662, "On the intercom screen —"], [3.3490416666666665, 4.6869375, "people *in white suits*."]]}, {"dur": 2.6351458333333335, "phr": [[0, 2.6351458333333335, "You jump from the second-floor balcony and *run*."]]}, {"dur": 4.5799583333333