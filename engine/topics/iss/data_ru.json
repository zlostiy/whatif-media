{"shots": [{"badge": "", "loc": "Орбита · 400 км", "scene": "orbit", "vo": "Ты на МКС. Четыреста километров над Землёй, скорость — *двадцать восемь тысяч* километров в час.", "card": "speed", "say": "Ты на эм-ка-эс. Четыреста километров над Землёй, скорость — двадцать восемь тысяч километров в час."}, {"badge": "", "loc": "МКС", "scene": "alarm", "vo": "Тревога: на станцию летит *облако обломков*."}, {"badge": "", "loc": "Архив · 2021", "scene": "archive", "vo": "Так было *на самом деле*: в две тысячи двадцать первом экипаж прятался в кораблях от обломков уничтоженного спутника."}, {"badge": "", "loc": "МКС", "scene": "hit", "vo": "Ты успеваешь в капсулу. *Удар*… и связь с Землёй пропадает."}, {"badge": "ДЕНЬ 1", "loc": "МКС", "scene": "sunrise", "vo": "Каждые девяносто минут — новый восход. *Шестнадцать* в сутки.", "card": "sun"}, {"badge": "ДЕНЬ 1", "loc": "МКС", "scene": "debris", "vo": "И каждые девяносто минут станция снова летит *сквозь обломки*."}, {"badge": "ДЕНЬ 2", "loc": "МКС", "scene": "ammonia", "vo": "Срабатывает датчик: *утечка аммиака*."}, {"badge": "ДЕНЬ 2", "loc": "МКС", "scene": "hatch", "vo": "Ты задраиваешь люки и уходишь в другой модуль. В две тысячи пятнадцатом такая тревога уже *выгнала экипаж*."}, {"badge": "ДЕНЬ 3", "loc": "МКС", "scene": "decay", "vo": "Станция каждый день проседает примерно на *сто метров*. Двигатели подталкивают её — по команде с Земли.", "card": "alt"}, {"badge": "ДЕНЬ 3", "loc": "МКС", "scene": "water", "vo": "Вода — из пота и мочи: станция возвращает *девяносто восемь процентов*.", "card": "water"}, {"badge": "ДЕНЬ 4", "loc": "МКС", "scene": "radio", "vo": "Последняя надежда — *любительское радио*. Через него астронавты говорят со школьниками."}, {"badge": "ДЕНЬ 4", "loc": "МКС", "scene": "answer", "vo": "Ты вызываешь Землю… и тебе *отвечает* радиолюбитель."}, {"badge": "ДЕНЬ 5", "loc": "МКС", "scene": "undock", "vo": "Расстыковка. Три с половиной часа *до дома*."}, {"badge": "ДЕНЬ 5", "loc": "Атмосфера · 120 км", "scene": "reentry", "vo": "На высоте ста двадцати километров — атмосфера. Тебя вжимает в кресло: перегрузка *в четыре-пять раз*.", "card": "g"}, {"badge": "ДЕНЬ 5", "loc": "Казахстан", "scene": "chute", "vo": "Парашют. За метр до земли — двигатели *мягкой посадки*."}, {"badge": "ДЕНЬ 5", "loc": "Казахстан", "scene": "land", "vo": "Удар. Степь. *Ты дома*."}, {"badge": "", "loc": "", "scene": "end", "vo": "А ты бы *полетел*?"}], "meta": [{"dur": 6.240541666666667, "phr": [[0.0, 0.8653333333333333, "Ты на МКС."], [1.3153333333333332, 3.0021041666666664, "Четыреста километров над Землёй,"], [3.2221041666666665, 3.838111819727891, "скорость —"], [3.838111819727891, 6.240541666666667, "*двадцать восемь тысяч* километров в час."]], "asr": 0.5}, {"dur": 2.0871875, "phr": [[0.0, 0.40725609756097564, "Тревога:"], [0.40725609756097564, 2.0871875, "на станцию летит *облако обломков*."]], "asr": 1.0}, {"dur": 6.499916666666667, "phr": [[0.0, 0.9979583333333332, "Так было *на самом деле*:"], [1.2179583333333333, 6.4999166666666675, "в две тысячи двадцать первом экипаж прятался в кораблях от обломков уничтоженного спутника."]], "asr": 1.0}, {"dur": 3.327958333333333, "phr": [[0.0, 1.1896666666666667, "Ты успеваешь в капсулу."], [1.6396666666666666, 1.9034622395833334, "*Удар*…"], [1.9034622395833334, 3.327958333333333, "и связь с Землёй пропадает."]], "asr": 1.0}, {"dur": 3.413666666666667, "phr": [[0.0, 1.1860416666666667, "Каждые девяносто минут —"], [1.4660416666666667, 2.2332878787878787, "новый восход."], [2.2332878787878787, 3.413666666666667, "*Шестнадцать* в сутки."]], "asr": 1.0}, {"dur": 2.9879583333333333, "phr": [[0.0, 2.9879583333333333, "И каждые девяносто минут станция снова летит *сквозь обломки*."]], "asr": 1.0}, {"dur": 2.08775, "phr": [[0.0, 1.0758333333333334, "Срабатывает датчик:"], [1.2958333333333334, 2.08775, "*утечка аммиака*."]], "asr": 1.0}, {"dur": 5.972395833333334, "phr": [[0.0, 2.5470625, "Ты задраиваешь люки и уходишь в другой модуль."], [2.9970625, 5.972395833333334, "В две тысячи пятнадцатом такая тревога уже *выгнала экипаж*."]], "asr": 1.0}, {"dur": 5.951416666666667, "phr": [[0.0, 2.8584791666666667, "Станция каждый день проседает примерно на *сто метров*."], [3.308479166666667, 4.726895833333334, "Двигатели подталкивают её —"], [5.006895833333334, 5.951416666666668, "по команде с Земли."]], "asr": 0.86}, {"dur": 3.7626875, "phr": [[0.0, 0.35069047619047616, "Вода —"], [0.35069047619047616, 1.2274166666666666, "из пота и мочи:"], [1.4474166666666666, 3.7626875, "станция возвращает *девяносто восемь процентов*."]], "asr": 1.0}, {"dur": 5.0799375, "phr": [[0.0, 1.1758333333333333, "Последняя надежда —"], [1.4558333333333333, 2.4553333333333334, "*любительское радио*."], [2.9053333333333335, 5.0799375, "Через него астронавты говорят со школьниками."]], "asr": 1.0}, {"dur": 3.121020833333333, "phr": [[0.0, 0.9954791666666667, "Ты вызываешь Землю…"], [1.5954791666666668, 3.1210208333333336, "и тебе *отвечает* радиолюбитель."]], "asr": 1.0}, {"dur": 2.4895416666666668, "phr": [[0.0, 0.7286463414634147, "Расстыковка."], [0.7286463414634147, 2.4895416666666668, "Три с половиной часа *до дома*."]], "asr": 1.0}, {"dur": 5.594145833333333, "phr": [[0.0, 1.717875, "На высоте ста двадцати километров —"], [1.997875, 2.614984375, "атмосфера."], [2.614984375, 3.972625, "Тебя вжимает в кресло:"], [4.192625, 5.594145833333333, "перегрузка *в четыре-пять раз*."]], "asr": 1.0}, {"dur": 3.0306875, "phr": [[0.0, 0.46562820512820513, "Парашют."], [0.46562820512820513, 1.513291666666667, "За метр до земли —"], [1.7932916666666667, 3.0306875, "двигатели *мягкой посадки*."]], "asr": 0.89}, {"dur": 1.3745, "phr": [[0.0, 0.3617105263157895, "Удар."], [0.3617105263157895, 0.7957631578947368, "Степь."], [0.7957631578947368, 1.3745, "*Ты дома*."]], "asr": 0.57}, {"dur": 0.8566458333333333, "phr": [[0.0, 0.8566458333333333, "А ты бы *полетел*?"]], "asr": 1.0}]}