{"shots": [{"badge": "", "loc": "Орбита · 400 км", "scene": "orbit", "vo": "Ты на МКС. Четыреста километров над Землёй, скорость — *двадцать восемь тысяч* километров в час.", "card": "speed", "say": "Ты на эм-ка-эс. Четыреста километров над Землёй, скорость — двадцать восемь тысяч километров в час."}, {"badge": "", "loc": "МКС", "scene": "alarm", "vo": "Тревога: на станцию летит *облако обломков*."}, {"badge": "", "loc": "Архив · 2021", "scene": "archive", "vo": "Так было *на самом деле*: в две тысячи двадцать первом экипаж прятался в кораблях от обломков уничтоженного спутника."}, {"badge": "", "loc": "МКС", "scene": "hit", "vo": "Ты успеваешь в капсулу. *Удар*… и связь с Землёй пропадает."}, {"badge": "ДЕНЬ 1", "loc": "МКС", "scene": "sunrise", "vo": "Каждые девяносто минут — новый восход. *Шестнадцать* в сутки.", "card": "sun"}, {"badge": "ДЕНЬ 1", "loc": "МКС", "scene": "debris", "vo": "И каждые девяносто минут станция снова летит *сквозь обломки*."}, {"badge": "ДЕНЬ 2", "loc": "МКС", "scene": "ammonia", "vo": "Срабатывает датчик: *утечка аммиака*."}, {"badge": "ДЕНЬ 2", "loc": "МКС", "scene": "hatch", "vo": "Ты задраиваешь люки и уходишь в другой модуль. В две тысячи пятнадцатом такая тревога уже *выгнала экипаж*."}, {"badge": "ДЕНЬ 3", "loc": "МКС", "scene": "decay", "vo": "Станция каждый день проседает примерно на *сто метров*. Двигатели подталкивают её — по команде с Земли.", "card": "alt"}, {"badge": "ДЕНЬ 3", "loc": "МКС", "scene": "water", "vo": "Вода — из пота и мочи: станция возвращает *девяносто восемь процентов*.", "card": "water"}, {"badge": "ДЕНЬ 4", "loc": "МКС", "scene": "radio", "vo": "Последняя надежда — *любительское радио*. Через него астронавты говорят со школьниками."}, {"badge": "ДЕНЬ 4", "loc": "МКС", "scene": "answer", "vo": "Ты вызываешь Землю… и тебе *отвечает* радиолюбитель."}, {"badge": "ДЕНЬ 5", "loc": "МКС", "scene": "undock", "vo": "Расстыковка. Три с половиной часа *до дома*."}, {"badge": "ДЕНЬ 5", "loc": "Атмосфера · 120 км", "scene": "reentry", "vo": "На высоте ста двадцати километров — атмосфера. Тебя вжимает в кресло: перегрузка *в четыре-пять раз*.", "card": "g"}, {"badge": "ДЕНЬ 5", "loc": "Казахстан", "scene": "chute", "vo": "Парашют. За метр до земли — двигатели *мягкой посадки*."}, {"badge": "ДЕНЬ 5", "loc": "Казахстан", "scene": "land", "vo": "Удар. Степь. *Ты дома*."}, {"badge": "", "loc": "", "scene": "end", "vo": "А ты бы *полетел*?"}], "meta": [{"dur": 6.1925625, "phr": [[0.0, 0.9080416666666667, "Ты на МКС."], [1.3580416666666666, 3.026208333333333, "Четыреста километров над Землёй,"], [3.246208333333333, 3.847505102040816, "скорость —"], [3.847505102040816, 6.192562499999999, "*двадцать восемь тысяч* километров в час."]], "asr": 0.5}, {"dur": 2.1491041666666666, "phr": [[0.0, 0.4193373983739837, "Тревога:"], [0.4193373983739837, 2.1491041666666666, "на станцию летит *облако обломков*."]], "asr": 1.0}, {"dur": 6.888520833333334, "phr": [[0.0, 1.2821875, "Так было *на самом деле*:"], [1.5021875, 6.888520833333333, "в две тысячи двадцать первом экипаж прятался в кораблях от обломков уничтоженного спутника."]], "asr": 1.0}, {"dur": 3.6189583333333335, "phr": [[0.0, 1.2231458333333334, "Ты успеваешь в капсулу."], [1.6731458333333333, 1.9771790364583333, "*Удар*…"], [1.9771790364583333, 3.6189583333333335, "и связь с Землёй пропадает."]], "asr": 1.0}, {"dur": 3.6631666666666667, "phr": [[0.0, 1.20825, "Каждые девяносто минут —"], [1.48825, 2.3450353535353536, "новый восход."], [2.3450353535353536, 3.663166666666667, "*Шестнадцать* в сутки."]], "asr": 1.0}, {"dur": 3.33425, "phr": [[0.0, 3.33425, "И каждые девяносто минут станция снова летит *сквозь обломки*."]], "asr": 0.89}, {"dur": 2.285041666666667, "phr": [[0.0, 1.100125, "Срабатывает датчик:"], [1.320125, 2.2850416666666664, "*утечка аммиака*."]], "asr": 1.0}, {"dur": 6.350458333333333, "phr": [[0.0, 2.688833333333333, "Ты задраиваешь люки и уходишь в другой модуль."], [3.1388333333333334, 6.350458333333334, "В две тысячи пятнадцатом такая тревога уже *выгнала экипаж*."]], "asr": 1.0}, {"dur": 6.090479166666666, "phr": [[0.0, 2.806208333333333, "Станция каждый день проседает примерно на *сто метров*."], [3.2562083333333334, 4.8423125, "Двигатели подталкивают её —"], [5.1223125000000005, 6.090479166666667, "по команде с Земли."]], "asr": 1.0}, {"dur": 4.2999583333333335, "phr": [[0.0, 0.4923035714285714, "Вода —"], [0.4923035714285714, 1.7230625, "из пота и мочи:"], [1.9430625, 4.299958333333333, "станция возвращает *девяносто восемь процентов*."]], "asr": 0.8}, {"dur": 5.416979166666667, "phr": [[0.0, 1.1206458333333333, "Последняя надежда —"], [1.4006458333333334, 2.397625, "*любительское радио*."], [2.8476250000000003, 5.416979166666668, "Через него астронавты говорят со школьниками."]], "asr": 1.0}, {"dur": 3.0445416666666665, "phr": [[0.0, 0.8775833333333335, "Ты вызываешь Землю…"], [1.4775833333333335, 3.0445416666666665, "и тебе *отвечает* радиолюбитель."]], "asr": 0.8}, {"dur": 2.683625, "phr": [[0.0, 0.7854512195121952, "Расстыковка."], [0.7854512195121952, 2.683625, "Три с половиной часа *до дома*."]], "asr": 0.86}, {"dur": 6.191416666666667, "phr": [[0.0, 1.8818125, "На высоте ста двадцати километров —"], [2.1618125, 2.86288671875, "атмосфера."], [2.86288671875, 4.4052500000000006, "Тебя вжимает в кресло:"], [4.62525, 6.191416666666667, "перегрузка *в четыре-пять раз*."]], "asr": 1.0}, {"dur": 3.6223125, "phr": [[0.0, 0.5616282051282051, "Парашют."], [0.5616282051282051, 1.8252916666666665, "За метр до земли —"], [2.105291666666667, 3.6223125000000005, "двигатели *мягкой посадки*."]], "asr": 1.0}, {"dur": 1.3781458333333334, "phr": [[0.0, 0.36266995614035086, "Удар."], [0.36266995614035086, 0.797873903508772, "Степь."], [0.797873903508772, 1.3781458333333334, "*Ты дома*."]], "asr": 0.86}, {"dur": 0.9546041666666667, "phr": [[0.0, 0.9546041666666667, "А ты бы *полетел*?"]], "asr": 1.0}]}