{"shots": [{"badge": "", "loc": "", "scene": "enter", "who": "n", "vo": "Your girlfriend steps out of the fitting room with *two* dresses."}, {"badge": "", "loc": "", "scene": "enter", "who": "g", "vo": "Which one is better?"}, {"badge": "", "loc": "", "scene": "exam", "who": "n", "vo": "You can feel it: this is not a question. It’s an *exam*."}, {"badge": "", "loc": "", "scene": "think", "who": "n", "vo": "Red or blue. You look for a long time. You think. You pick *red*."}, {"badge": "", "loc": "", "scene": "pause", "who": "n", "vo": "She is silent for three seconds."}, {"badge": "", "loc": "", "scene": "pause", "who": "g", "vo": "Why *not the blue* one?"}, {"badge": "", "loc": "", "scene": "trap", "who": "n", "vo": "You say: “The blue one is great too.”"}, {"badge": "", "loc": "", "scene": "trap", "who": "g", "vo": "So you *don’t like* the red one?"}, {"badge": "", "loc": "", "scene": "exit", "who": "n", "vo": "Ten minutes later you leave the store. With the blue dress. And the red one. *You pay*."}, {"badge": "", "loc": "", "scene": "end", "who": "n", "vo": "Which one would *you* pick?"}], "meta": [{"dur": 3.2405416666666667, "phr": [[0, 3.2405416666666667, "Your girlfriend steps out of the fitting room with *two* dresses."]]}, {"dur": 1.0393541666666666, "phr": [[0, 1.0393541666666666, "Which one is better?"]]}, {"dur": 4.1288125, "phr": [[0, 0.9362291666666667, "You can feel it:"], [1.1562291666666666, 2.6898958333333334, "this is not a question."], [3.1398958333333336, 4.1288125, "It’s an *exam*."]]}, {"dur": 5.399604166666666, "phr": [[0, 0.9878125, "Red or blue."], [1.4378125, 2.8577916666666665, "You look for a long time."], [3.3077916666666667, 4.050833333333333, "You think."], [4.5008333333333335, 5.399604166666666, "You pick *red*."]]}, {"dur": 1.75675, "phr": [[0, 1.75675, "She is silent for three seconds."]]}, {"dur": 1.1426875, "phr": [[0, 1.1426875, "Why *not the blue* one?"]]}, {"dur": 2.43675, "phr": [[0, 0.6979583333333333, "You say:"], [0.9179583