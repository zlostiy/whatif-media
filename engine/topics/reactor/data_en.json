{"shots": [{"badge": "SIMULATOR", "loc": "Reactor console", "scene": "intro", "vo": "No skill is ever wasted. Today we learn to run a *nuclear reactor*. For now — on a simulator."}, {"badge": "SIMULATOR", "loc": "Diagram", "scene": "boiler", "vo": "A reactor is a boiler. Uranium heats water, steam spins a turbine, and the turbine lights up a *whole city*."}, {"badge": "STEP 1", "loc": "Reactor console", "scene": "rods", "vo": "First — the *control rods*. Lower them and the reaction calms down. Raise them and power goes up."}, {"badge": "STEP 2", "loc": "Reactor console", "scene": "pumps", "vo": "Second — the *pumps*. They push water through the core. No water — the reactor *overheats*."}, {"badge": "STEP 3", "loc": "Reactor console", "scene": "button", "vo": "Third — the big *red button*: emergency shutdown. All rods drop at once, and the reactor stops."}, {"badge": "MISTAKE", "loc": "Reactor console", "scene": "hurry", "vo": "You are in a hurry: almost all rods are up, the pumps are slowed down. The power needle creeps up. You slam *the red button*…"}, {"badge": "MISTAKE", "loc": "Simulator", "scene": "boom", "vo": "…and for a second the power doesn’t fall. It *jumps*."}, {"badge": "1986", "loc": "Chernobyl plant", "scene": "real", "vo": "That really happened. April 26, *1986*, Chernobyl. The operators pressed the emergency button — *AZ-5*. The rods had graphite tips, and in the first seconds they *sped up* the reaction."}, {"badge": "1986", "loc": "Chernobyl plant", "scene": "steam", "vo": "It was not a nuclear blast but a *steam* explosion. Still, it destroyed the reactor, and radiation spread *across Europe*."}, {"badge": "LESSON", "loc": "Reactor console", "scene": "end", "vo": "A reactor has no “undo” button. Would you take *the console*?"}], "meta": [{"dur": 6.7053125, "phr": [[0, 1.5515416666666666, "No skill is ever wasted."], [2.0015416666666668, 4.367708333333333, "Today we learn to run a *nuclear reactor*."], [4.817708333333333, 5.402333333333333, "For now —"], [5.682333333333333, 6.7053125, "on a simulator."]]}, {"dur": 6.8501666666666665, "phr": [[0, 1.3551458333333333, "A reactor is a boiler."], [1.8051458333333332, 3.221875, "Uranium heats water,"], [3.441875, 4.764520833333333, "steam spins a turbine,"], [4.984520833333333, 6.8501666666666665, "and the turbine lights up a *whole city*."]]}, {"dur": 6.742479166666667, "phr": [[0, 0.5458333333333333, "First —"], [0.8258333333333333, 1.9554375, "the *control rods*."], [2.4054375, 4.699916666666667, "Lower them and the reaction calms down."], [5.149916666666667, 6.7424791666666675, "Raise them and power goes up."]]}, {"dur": 6.121333333333333, "phr": [[0, 0.5758958333333334, "Second —"], [0.8558958333333334, 1.5039583333333333, "the *pumps*."], [1.9539583333333332, 3.400875, "They push water through the core."], [3.8508750000000003, 4.5786875, "No water —"], [4.8586875, 6.121333333333333, "the reactor *overheats*."]]}, {"dur": 6.511083333333334, "phr": [[0, 0.37695833333333334, "Third —"], [0.6569583333333333, 1.7430208333333332, "the big *red button*:"], [1.9630208333333332, 3.255708333333333, "emergency shutdown."], [3.7057083333333334, 5.086916666666667, "All rods drop at once,"], [5.306916666666667, 6.511083333333334, "and the reactor stops."]]}, {"dur": 7.737916666666667, "phr": [[0, 0.9893333333333333, "You are in a hurry:"], [1.2093333333333334, 2.5844791666666667, "almost all rods are up,"], [2.804479166666667, 4.120791666666667, "the pumps are slowed down."], [4.5707916666666675, 5.936020833333334, "The power needle creeps up."], [6.386020833333334, 7.737916666666667, "You slam *the red button*…"]]}, {"dur": 3.132041666666667, "phr": [[0, 1.9619791666666666, "…and for a second the power doesn’t fall."], [2.411979166666667, 3.132041666666667, "It *jumps*."]]}, {"dur": 13.168645833333333, "phr": [[0, 0.9960625, "That really happened."], [1.4460625, 2.5754791666666668, "April 26,"], [2.795479166666667, 4.088208333333334, "*1986*,"], [4.308208333333334, 4.9625416666666675, "Chernobyl."], [5.412541666666668, 7.371875000000001, "The operators pressed the emergency button —"], [7.651875000000001, 8.474083333333335, "*AZ-5*."], [8.924083333333334, 10.401333333333334, "The rods had graphite tips,"], [10.621333333333334, 13.168645833333334, "and in the first seconds they *sped up* the reaction."]]}, {"dur": 7.533708333333333, "phr": [[0, 2.8210416666666664, "It was not a nuclear blast but a *steam* explosion."], [3.2710416666666666, 3.786083333333333, "Still,"], [4.006083333333333, 5.341791666666666, "it destroyed the reactor,"], [5.561791666666665, 7.533708333333332, "and radiation spread *across Europe*."]]}, {"dur": 3.496541666666667, "phr": [[0, 1.7787291666666667, "A reactor has no “undo” button."], [2.2287291666666667, 3.4965416666666664, "Would you take *the console*?"]]}]}