{"shots": [{"badge": "DAY 1", "loc": "Sahara", "scene": "run", "vo": "You're running a marathon across the Sahara. It's *a hundred fifteen* degrees.", "card": "temp"}, {"badge": "DAY 1", "loc": "Sahara", "scene": "storm", "vo": "A sandstorm hits. For *eight hours*, you run blind."}, {"badge": "DAY 1", "loc": "Sahara", "scene": "lost", "vo": "The storm dies down. *The trail is gone*."}, {"badge": "DAY 1", "loc": "Archive · 1994", "scene": "archive", "vo": "This really happened to an Italian, *Mauro Prosperi*, in nineteen ninety-four.", "card": "who"}, {"badge": "DAY 1", "loc": "Sahara", "scene": "bush", "vo": "You spend the night *under a bush*."}, {"badge": "DAY 2", "loc": "Sahara", "scene": "search", "vo": "You run for four hours, but find *no people and no trail markers*."}, {"badge": "DAY 2", "loc": "Sahara", "scene": "bottle", "vo": "Your water is almost gone. You start saving *your own urine*.", "card": "waterlvl"}, {"badge": "DAY 2", "loc": "Sahara", "scene": "heli", "vo": "Sunset. A helicopter! You fire a flare, but *the pilot doesn't see it*."}, {"badge": "DAY 3", "loc": "Shrine", "scene": "shrine", "vo": "You find an abandoned shrine. *Shade*."}, {"badge": "DAY 3", "loc": "Shrine", "scene": "bats", "vo": "Bats hang from the ceiling. Prosperi *drank their blood*."}, {"badge": "DAY 4", "loc": "Shrine", "scene": "sos", "vo": "A plane flies over. You spell *SOS* in the sand and light a fire."}, {"badge": "DAY 4", "loc": "Shrine", "scene": "storm2", "vo": "No one sees you. Then comes a second storm — *twelve hours* long."}, {"badge": "DAY 5", "loc": "Shrine", "scene": "dew", "vo": "You lick dew off the rocks and suck on *wet wipes*."}, {"badge": "DAY 5", "loc": "Shrine", "scene": "flag", "vo": "You eat beetles and bird eggs. On the shrine roof — *an Italian flag*."}, {"badge": "DAY 6", "loc": "Sahara", "scene": "leave", "vo": "You realize: if you stay, no one will find you. *For your wife*, you leave."}, {"badge": "DAY 6", "loc": "Sahara", "scene": "walk", "vo": "You walk at dawn and dusk. By day, you hide *in the shade of the rocks*."}, {"badge": "DAY 7", "loc": "Sahara", "scene": "night", "vo": "At night, you bury yourself in sand. Desert nights are *cold*."}, {"badge": "DAY 7", "loc": "Sahara", "scene": "food", "vo": "You eat roots, *snakes and lizards*."}, {"badge": "DAY 8", "loc": "Oasis", "scene": "oasis", "vo": "An oasis. *A puddle of water*. Your throat is so swollen you can't swallow."}, {"badge": "DAY 8", "loc": "Oasis", "scene": "drink", "vo": "You drink drop by drop, lying by the water. For the first time in a week, *you sleep*."}, {"badge": "DAY 9", "loc": "Algeria", "scene": "tracks", "vo": "Goat tracks. Then human ones. *A Tuareg girl* is herding goats."}, {"badge": "DAY 9", "loc": "Algeria", "scene": "map", "vo": "You wandered *a hundred eighty miles* off course — into another country, Algeria.", "card": "map"}, {"badge": "DAY 9", "loc": "Hospital", "scene": "hospital", "vo": "Thirty-three pounds lost. His liver took *almost two years* to heal.", "card": "weight"}, {"badge": "DAY 9", "loc": "Sahara", "scene": "return", "vo": "Years later, he came back to run this marathon again. *More than once*."}, {"badge": "", "loc": "", "scene": "end", "vo": "Would *you* go back?"}], "meta": [{"dur": 4.134354166666666, "phr": [[0, 2.169604166666667, "You're running a marathon across the Sahara."], [2.619604166666667, 4.134354166666667, "It's *a hundred fifteen* degrees."]]}, {"dur": 3.6465625, "phr": [[0, 1.1303125, "A sandstorm hits."], [1.5803125, 2.4558541666666667, "For *eight hours*,"], [2.675854166666667, 3.6465625, "you run blind."]]}, {"dur": 2.7651458333333334, "phr": [[0, 1.283875, "The storm dies down."], [1.733875, 2.7651458333333334, "*The trail is gone*."]]}, {"dur": 4.531, "phr": [[0, 1.7334583333333333, "This really happened to an Italian,"], [1.9534583333333333, 3.0049583333333336, "*Mauro Prosperi*,"], [3.224958333333334, 4.531000000000001, "in nineteen ninety-four."]]}, {"dur": 1.5335625, "phr": [[0, 